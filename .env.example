# --- Docker ---
# UID/GID хостового пользователя - чтобы файлы, созданные composer/php-контейнерами
# (vendor/, storage/, bootstrap/cache), не становились root-owned на хосте.
UID=1000
GID=1000

# Путь к dump.sql старого проекта (start-stop/OpenCart) для первичного импорта
# в схему legacy внутри db-контейнера. Меняйте только если старый проект
# лежит не в стандартном месте.
LEGACY_DUMP_PATH=/home/archivarius/app/start-stop/dump.sql

# --- Laravel app config ---
# Эти строки добавляет сюда же composer create-project laravel/laravel .
# (копирует свой .env.example поверх, если файла .env ещё нет).
#
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=user
# DB_PASSWORD=
#
# db-сервис в docker-compose.yml берёт MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD
# прямо из DB_DATABASE/DB_USERNAME/DB_PASSWORD выше - один источник правды,
# не нужно дублировать пароль в двух местах (паттерн из fridge-service).
# MYSQL_ROOT_PASSWORD тоже = DB_PASSWORD, это только для локальной разработки.

# Второе соединение для чтения legacy-данных старого проекта (Фаза 2 плана)
# DB_LEGACY_HOST=db
# DB_LEGACY_PORT=3306
# DB_LEGACY_DATABASE=legacy
# DB_LEGACY_USERNAME=user
# DB_LEGACY_PASSWORD=
